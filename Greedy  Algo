class Solution {
public:
    int findContentChildren(vector<int>& g, vector<int>& s) {
        sort(g.begin() , g.end());
        sort(s.begin() , s.end());

        int n = g.size();
        int m = s.size();

        int gIndex = 0;
        int sIndex = 0;

        while(gIndex < n && sIndex < m){
            if(s[sIndex] >= g[gIndex]){
                gIndex++;
            }
            sIndex++;
        }
        return gIndex;
    }
};

***1. Fractional Knapsack:***

class Solution {
public:

bool comp(pair<long long , long long> &a , pair<long long , long long> &b){
    return (double)a.first / a.second > (double)b.first / b.second;
}
    double fractionalKnapsack(vector<long long>& val, vector<long long>& wt, long long capacity) {
        int n = val.size();
        vector<pair<long long , long long>> arr;

        for(int i = 0; i < n; i++){
            arr.push_back({val[i] , wt[i]});
        }
        sort(arr.begin() , arr.end());
        double totalVal = 0;

        for(int i = 0; i < n; i++){
            if(arr[i].second <= capacity){
                totalVal += arr[i].first;
                capacity -= arr[i].second;
            }else{
                totalVal += ((double)arr[i].first / arr[i].second) * capacity;
            }
        }
        return totalVal;
    }
};
